//@version=5
// MGC V2.0 — 10,000 美元微型黄金期货
// 粘贴到 TradingView Pine 编辑器，图表用 COMEX:MGC1!，周期 5 分钟。
// 手数、止损上限和风险百分比必须与 mgc-v2/rules.py 一致。
strategy("MGC V2.0 10K", overlay=true, initial_capital=10000, currency=currency.USD,
     default_qty_type=strategy.fixed, default_qty_value=1, pyramiding=0,
     commission_type=strategy.commission.cash_per_contract, commission_value=0.62,
     slippage=1, process_orders_on_close=false, calc_on_every_tick=false,
     margin_long=5, margin_short=5, max_labels_count=500)

if math.abs(syminfo.pointvalue - 10) > 0.001 or math.abs(syminfo.mintick - 0.1) > 0.0000001
    runtime.error("只允许点值为 10、最小跳动为 0.1 的 MGC。不要用 GC 或现货黄金。")
if timeframe.in_seconds() != 300
    runtime.error("请切换到 5 分钟图。")

// ---- 可调参数。验收时的对照变体只改这几项。 ----
fastLen = input.int(20, "EMA 快线", minval=2)
slowLen = input.int(50, "EMA 慢线", minval=3)
adxMin = input.float(18.0, "15 分钟 ADX 下限", minval=1)
sepK = input.float(0.10, "60 分钟均线分离（ATR 倍数）", minval=0, step=0.01)
atrMult = input.float(1.2, "ATR 止损倍数", minval=0.5, step=0.1)
minStop = input.float(5.0, "止损下限 $/oz", minval=0.1, step=0.1)
maxStop = input.float(12.0, "止损上限 $/oz", minval=0.1, step=0.1)
targetR = input.float(2.2, "止盈 R", minval=0.5, step=0.1)
beOffset = input.float(0.5, "保本后的止损偏移 $/oz", minval=0, step=0.1)
lockAtR = input.float(1.5, "锁定盈利的触发 R", minval=0.5, step=0.1)
lockR = input.float(0.8, "锁定到的 R", minval=0, step=0.1)
maintenance = input.float(2085.0, "单手维持保证金（美元）", minval=1)
dailyLossCash = input.float(200.0, "当日亏损上限（美元）", minval=1)
weeklyLossCash = input.float(400.0, "当周亏损上限（美元）", minval=1)
allowEntries = input.bool(true, "允许开仓（CPI / 非农 / FOMC 当天关掉）")
showTable = input.bool(true, "显示状态表")

strategy.risk.max_intraday_loss(dailyLossCash, strategy.cash)

tick = syminfo.mintick
equity = strategy.equity

// 高周期只用已经收盘的 K 线，避免信号在形成过程中来回改变。
f15() =>
    [plus, minus, adxValue] = ta.dmi(14, 14)
    [ta.ema(close, fastLen)[1], ta.ema(close, slowLen)[1], adxValue[1]]

f60() =>
    [ta.ema(close, fastLen)[1], ta.ema(close, slowLen)[1], ta.atr(14)[1], close[1]]

fDay() =>
    [close[1], ta.ema(close, slowLen)[1]]

[m15e20, m15e50, m15adx] = request.security(syminfo.tickerid, "15", f15(), barmerge.gaps_off, barmerge.lookahead_off)
[h1e20, h1e50, h1atr, h1close] = request.security(syminfo.tickerid, "60", f60(), barmerge.gaps_off, barmerge.lookahead_off)
[dClose, dEma] = request.security(syminfo.tickerid, "D", fDay(), barmerge.gaps_off, barmerge.lookahead_off)

ema20 = ta.ema(close, fastLen)
ema50 = ta.ema(close, slowLen)
atr = ta.atr(14)

// ---- 交易日 / 交易周盈亏 ----
var float dayRealized = 0.0
var float weekRealized = 0.0
var int seenTrades = 0
var int tradesToday = 0
var int signalBar = -1

if timeframe.change("D")
    dayRealized := 0.0
    tradesToday := 0
    signalBar := -1
    strategy.cancel("L")
    strategy.cancel("S")
if timeframe.change("W")
    weekRealized := 0.0

if strategy.closedtrades > seenTrades
    for t = seenTrades to strategy.closedtrades - 1
        p = strategy.closedtrades.profit(t)
        dayRealized += p
        weekRealized += p
    seenTrades := strategy.closedtrades

dayPnl = dayRealized + strategy.openprofit
weekPnl = weekRealized + strategy.openprofit

// ---- 方向与形态 ----
ready = not na(h1close) and not na(h1atr) and not na(dClose) and not na(m15adx) and not na(atr) and h1atr > 0 and atr > 0
separated = math.abs(h1e20 - h1e50) >= h1atr * sepK
longBias = ready and h1close > h1e50 and h1e20 > h1e50 and separated and dClose > dEma and m15e20 > m15e50 and m15adx >= adxMin
shortBias = ready and h1close < h1e50 and h1e20 < h1e50 and separated and dClose < dEma and m15e20 < m15e50 and m15adx >= adxMin

barRange = high - low
upperClose = barRange >= tick and (close - low) >= 0.55 * barRange
lowerClose = barRange >= tick and (high - close) >= 0.55 * barRange
touchLong = low <= ema20 and close > ema20 and ema20 > ema50 and close > open and upperClose
touchShort = high >= ema20 and close < ema20 and ema20 < ema50 and close < open and lowerClose

rawDist = math.max(barRange + 2 * tick, math.max(atr * atrMult, minStop))
dist = math.round(rawDist / tick) * tick
stopFits = dist >= minStop and dist <= maxStop

riskOne = dist * 10.0
marginOk = maintenance <= equity * 0.30
alive = equity > 8500
byRisk = riskOne > 0 ? int(math.floor((equity * 0.01) / riskOne)) : 0
byMargin = int(math.floor((equity * 0.25) / maintenance))
hardCap = equity < 20000 ? 1 : equity < 40000 ? 2 : 3
qty = alive and marginOk and stopFits and riskOne <= equity * 0.012 ? math.max(0, math.min(byRisk, math.min(byMargin, hardCap))) : 0
elevated = false
if qty == 0 and alive and marginOk and stopFits and riskOne <= equity * 0.012
    qty := 1
    elevated := true
if qty > 0 and riskOne * qty > equity * 0.01
    elevated := true

inWindow = not na(time(timeframe.period, "0830-1300", "America/New_York"))
flatNow = not na(time(timeframe.period, "1545-1700", "America/New_York"))
canEnter = allowEntries and inWindow and tradesToday < 2 and dayPnl > -dailyLossCash and weekPnl > -weeklyLossCash and strategy.position_size == 0

var float orderDist = na
var float orderTrigger = na

if signalBar >= 0 and strategy.position_size == 0 and bar_index > signalBar + 2
    strategy.cancel("L")
    strategy.cancel("S")
    signalBar := -1

longSetup = barstate.isconfirmed and canEnter and signalBar < 0 and longBias and touchLong and qty >= 1
shortSetup = barstate.isconfirmed and canEnter and signalBar < 0 and shortBias and touchShort and qty >= 1

if longSetup
    trigger = high + tick
    strategy.entry("L", strategy.long, qty=qty, stop=trigger, comment="L " + str.tostring(riskOne * qty, "#"))
    strategy.exit("XL", from_entry="L", stop=trigger - dist, limit=trigger + dist * targetR)
    signalBar := bar_index
    orderDist := dist
    orderTrigger := trigger
    alert("MGC V2.0 做多 | 买停 " + str.tostring(trigger, format.mintick) + " | 止损距离 " + str.tostring(dist, format.mintick) + " | 手数 " + str.tostring(qty) + " | 风险 $" + str.tostring(riskOne * qty, "#") + (elevated ? " | 超目标风险" : "") + " | 2 根 5 分钟 K 线未成交则撤销", alert.freq_once_per_bar_close)

if shortSetup
    trigger = low - tick
    strategy.entry("S", strategy.short, qty=qty, stop=trigger, comment="S " + str.tostring(riskOne * qty, "#"))
    strategy.exit("XS", from_entry="S", stop=trigger + dist, limit=trigger - dist * targetR)
    signalBar := bar_index
    orderDist := dist
    orderTrigger := trigger
    alert("MGC V2.0 做空 | 卖停 " + str.tostring(trigger, format.mintick) + " | 止损距离 " + str.tostring(dist, format.mintick) + " | 手数 " + str.tostring(qty) + " | 风险 $" + str.tostring(riskOne * qty, "#") + (elevated ? " | 超目标风险" : "") + " | 2 根 5 分钟 K 线未成交则撤销", alert.freq_once_per_bar_close)

// ---- 持仓管理。止损上移只用上一根已收盘 K 线，避免同一根里又保本又止损的乐观成交。 ----
var float activeDist = na
var float activeEntry = na
var int activeBar = -1
var float activeMfe = 0.0
var int countedBar = -1

pos = strategy.position_size
justOpened = pos != 0 and nz(pos[1]) == 0
if justOpened
    activeEntry := strategy.position_avg_price
    activeDist := orderDist
    activeBar := bar_index
    activeMfe := 0.0
    signalBar := -1
    if countedBar != bar_index
        tradesToday += 1
        countedBar := bar_index

slipTooFar = justOpened and not na(orderTrigger) and (pos > 0 ? activeEntry - orderTrigger : orderTrigger - activeEntry) > 2 * tick

if pos > 0 and not na(activeEntry)
    activeMfe := math.max(activeMfe, high - activeEntry)
if pos < 0 and not na(activeEntry)
    activeMfe := math.max(activeMfe, activeEntry - low)

barsHeld = activeBar >= 0 ? bar_index - activeBar : 0
favorClose = pos > 0 ? close - activeEntry : activeEntry - close
timeStop = pos != 0 and barstate.isconfirmed and not na(activeDist) and ((barsHeld >= 6 and activeMfe < activeDist * 0.5) or (barsHeld >= 18 and favorClose < activeDist))
weekStop = pos != 0 and weekPnl <= -weeklyLossCash

if slipTooFar or flatNow or timeStop or weekStop
    strategy.close_all(comment=slipTooFar ? "slip" : flatNow ? "flat" : weekStop ? "week" : "time")
else if pos > 0 and not na(activeDist)
    stopPrice = activeEntry - activeDist
    if bar_index > activeBar and high[1] >= activeEntry + activeDist
        stopPrice := math.max(stopPrice, activeEntry + beOffset)
    if bar_index > activeBar and high[1] >= activeEntry + activeDist * lockAtR
        stopPrice := math.max(stopPrice, activeEntry + activeDist * lockR)
    strategy.exit("XL", from_entry="L", stop=stopPrice, limit=activeEntry + activeDist * targetR)
else if pos < 0 and not na(activeDist)
    stopPrice = activeEntry + activeDist
    if bar_index > activeBar and low[1] <= activeEntry - activeDist
        stopPrice := math.min(stopPrice, activeEntry - beOffset)
    if bar_index > activeBar and low[1] <= activeEntry - activeDist * lockAtR
        stopPrice := math.min(stopPrice, activeEntry - activeDist * lockR)
    strategy.exit("XS", from_entry="S", stop=stopPrice, limit=activeEntry - activeDist * targetR)

plot(ema20, "EMA20", color=color.new(color.teal, 0))
plot(ema50, "EMA50", color=color.new(color.orange, 0))
bgcolor(longBias and inWindow ? color.new(color.teal, 92) : shortBias and inWindow ? color.new(color.red, 92) : na)

var table board = table.new(position.top_right, 2, 8, bgcolor=color.new(color.black, 20))
if showTable and barstate.islast
    biasText = longBias ? "多" : shortBias ? "空" : "观望"
    table.cell(board, 0, 0, "权益", text_color=color.white)
    table.cell(board, 1, 0, str.tostring(equity, "#"), text_color=color.white)
    table.cell(board, 0, 1, "今日盈亏", text_color=color.white)
    table.cell(board, 1, 1, str.tostring(dayPnl, "#"), text_color=color.white)
    table.cell(board, 0, 2, "本周盈亏", text_color=color.white)
    table.cell(board, 1, 2, str.tostring(weekPnl, "#"), text_color=color.white)
    table.cell(board, 0, 3, "今日笔数", text_color=color.white)
    table.cell(board, 1, 3, str.tostring(tradesToday), text_color=color.white)
    table.cell(board, 0, 4, "方向", text_color=color.white)
    table.cell(board, 1, 4, biasText, text_color=color.white)
    table.cell(board, 0, 5, "本根止损距离", text_color=color.white)
    table.cell(board, 1, 5, stopFits ? str.tostring(dist, format.mintick) : "放弃", text_color=color.white)
    table.cell(board, 0, 6, "本根手数", text_color=color.white)
    table.cell(board, 1, 6, str.tostring(qty), text_color=color.white)
    table.cell(board, 0, 7, "允许开仓", text_color=color.white)
    table.cell(board, 1, 7, canEnter ? "是" : "否", text_color=color.white)
